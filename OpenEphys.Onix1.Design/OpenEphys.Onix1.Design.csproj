<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>OpenEphys.Onix1.Design</Title>
    <Description>Bonsai Library containing visual interfaces for configuring ONIX devices.</Description>
    <PackageTags>Bonsai Rx Open Ephys Onix Design</PackageTags>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Design" Version="2.9.0" />
    <PackageReference Include="Bonsai.Dsp" Version="2.9.0" />
    <PackageReference Include="Bonsai.Design.Visualizers" Version="2.9.0" />
    <PackageReference Include="Bonsai.System.Design" Version="2.9.0" />
    <PackageReference Include="clroni" Version="6.3.0" />
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" GeneratePathProperty="true" />
    <PackageReference Include="Hexa.NET.ImGui.Backends" Version="1.0.18" GeneratePathProperty="true" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="OpenCV.Net" Version="3.4.2" />
    <PackageReference Include="OpenEphys.ProbeInterface.NET" Version="0.5.0" />
    <PackageReference Include="OpenTK" Version="3.3.3" />
    <PackageReference Include="OpenTK.GLControl" Version="3.3.3" />
    <PackageReference Include="ZedGraph" Version="5.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenEphys.Onix1\OpenEphys.Onix1.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenEphys.Onix1.Design.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- NB: pinned for compile-time version floors only. RemoveHostProvidedRuntimeAssemblies
         below strips the deployed copies at build time. -->
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

  <!-- NB: Bonsai.exe already embeds its own copy of these assemblies. A second standalone copy
       in this project's output directory creates two distinct assembly identities for the same
       simple name/version, which breaks type identity for calls crossing between them (observed
       with Span<T>, defined in System.Memory). This deletes the deployed copies after build so
       the process uses Bonsai's copy at runtime. -->
  <Target Name="RemoveHostProvidedRuntimeAssemblies" AfterTargets="CopyNativeDependencies">
    <ItemGroup>
      <HostProvidedRuntimeAssemblies Include="$(OutputPath)System.Memory.dll" />
      <HostProvidedRuntimeAssemblies Include="$(OutputPath)System.Buffers.dll" />
      <HostProvidedRuntimeAssemblies Include="$(OutputPath)System.Numerics.Vectors.dll" />
      <HostProvidedRuntimeAssemblies Include="$(OutputPath)System.Runtime.CompilerServices.Unsafe.dll" />
    </ItemGroup>
    <Delete Files="@(HostProvidedRuntimeAssemblies)" TreatErrorsAsWarnings="true" />
  </Target>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CopyNativeDependencies" AfterTargets="AfterBuild">
    <ItemGroup>
      <NativeDlls Include="$(PkgHexa_NET_ImGui_Backends)\runtimes\win-x64\native\ImGuiImpl.dll" />
      <NativeDlls Include="$(PkgHexa_NET_ImGui)\runtimes\win-x64\native\cimgui.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeDlls)" DestinationFolder="$(OutputPath)" />
  </Target>

  <!--
    Default ProbeInterface JSON resources are gzipped down to a small fraction
    of their raw size. Compressing them at build time, rather than committing
    pre-compressed .gz files, keeps the plaintext .json under Resources readable.
  -->
  <ItemGroup>
    <ProbeInterfaceJsonSource Include="Resources\NP1000.json" />
    <ProbeInterfaceJsonSource Include="Resources\NP1010.json" />
    <ProbeInterfaceJsonSource Include="Resources\NP1015.json" />
    <ProbeInterfaceJsonSource Include="Resources\NP1020.json" />
    <ProbeInterfaceJsonSource Include="Resources\NP1022.json" />
    <ProbeInterfaceJsonSource Include="Resources\NP1030.json" />
    <ProbeInterfaceJsonSource Include="Resources\NP1032.json" />
    <ProbeInterfaceJsonSource Include="Resources\NP1100.json" />
    <ProbeInterfaceJsonSource Include="Resources\NP1110.json" />
    <ProbeInterfaceJsonSource Include="Resources\NP1120.json" />
    <ProbeInterfaceJsonSource Include="Resources\NP1121.json" />
    <ProbeInterfaceJsonSource Include="Resources\NP1122.json" />
    <ProbeInterfaceJsonSource Include="Resources\NP1123.json" />
    <ProbeInterfaceJsonSource Include="Resources\NP2003.json" />
    <ProbeInterfaceJsonSource Include="Resources\NP2013.json" />
    <ProbeInterfaceJsonSource Include="Resources\OEHSRHS2116.json" />
  </ItemGroup>

  <UsingTask
    TaskName="GZipCompress"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <DestinationFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
Directory.CreateDirectory(Path.GetDirectoryName(DestinationFile));
using (var input = File.OpenRead(SourceFile))
using (var output = File.Create(DestinationFile))
using (var gzip = new GZipStream(output, CompressionLevel.Optimal))
{
    input.CopyTo(gzip);
}
]]>
      </Code>
    </Task>
  </UsingTask>

  <!--
    Inputs/Outputs transformed directly from the same source item (the standard MSBuild
    "compile per file" idiom) make this incremental per-item: MSBuild only re-invokes
    GZipCompress for a source .json newer than its own (already-computed) .gz output,
    skipping the rest on every build where the source hasn't changed.
  -->
  <Target Name="CompressProbeInterfaceResources"
          BeforeTargets="AssignTargetPaths"
          Inputs="@(ProbeInterfaceJsonSource)"
          Outputs="@(ProbeInterfaceJsonSource->'$(IntermediateOutputPath)Resources\%(Filename)%(Extension).gz')">
    <GZipCompress
      SourceFile="%(ProbeInterfaceJsonSource.Identity)"
      DestinationFile="$(IntermediateOutputPath)Resources\%(ProbeInterfaceJsonSource.Filename)%(ProbeInterfaceJsonSource.Extension).gz" />
  </Target>

  <!--
    A separate, unconditional target: EmbeddedResource must be registered on every build
    (referencing whichever .gz files exist on disk, freshly regenerated or not), not only when
    CompressProbeInterfaceResources's own Inputs/Outputs check decides its body needs to run.

    LogicalName is spelled out against %(ProbeInterfaceJsonSource.*) explicitly, not the bare
    %(Filename)/%(Extension) shorthand: metadata on an Include="@(X->'...')" transform batches
    against the source item X, so the bare form would (correctly, if confusingly) resolve to
    X's own Filename/Extension ("NP1000"/".json"), not the transformed .gz path's. The upshot is
    the embedded logical name stays plain "....json", matching what DesignResource's lookup
    name already expects unchanged, even though the bytes behind it are gzip compressed; only
    DesignResource's own decompression step needs to know that.
  -->
  <Target Name="AddCompressedProbeInterfaceResources" BeforeTargets="AssignTargetPaths" DependsOnTargets="CompressProbeInterfaceResources">
    <ItemGroup>
      <EmbeddedResource Include="@(ProbeInterfaceJsonSource->'$(IntermediateOutputPath)Resources\%(Filename)%(Extension).gz')">
        <LogicalName>OpenEphys.Onix1.Design.Resources.%(ProbeInterfaceJsonSource.Filename)%(ProbeInterfaceJsonSource.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
